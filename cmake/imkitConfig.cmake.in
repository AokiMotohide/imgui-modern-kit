@PACKAGE_INIT@
set(IMKIT_FONT_ASSET_DIR "${PACKAGE_PREFIX_DIR}/share/imkit/fonts")
include("${CMAKE_CURRENT_LIST_DIR}/imkitFontAssets.cmake")
if(NOT DEFINED IMKIT_IMGUI_TARGET OR NOT TARGET "${IMKIT_IMGUI_TARGET}")
    message(FATAL_ERROR "Create the host Dear ImGui target and set IMKIT_IMGUI_TARGET before find_package(imkit).")
endif()
set(IMKIT_SDK_SYSTEM_NAME "@IMKIT_SDK_SYSTEM_NAME@")
set(IMKIT_SDK_PROCESSOR "@IMKIT_SDK_PROCESSOR@")
set(IMKIT_SDK_ARCHITECTURES "@IMKIT_SDK_ARCHITECTURES@")
set(IMKIT_SDK_COMPILER_ID "@IMKIT_SDK_COMPILER_ID@")
set(IMKIT_SDK_COMPILER_VERSION "@IMKIT_SDK_COMPILER_VERSION@")
set(IMKIT_SDK_IMGUI_COMMIT "@IMKIT_SDK_IMGUI_COMMIT@")
if(NOT CMAKE_SYSTEM_NAME STREQUAL IMKIT_SDK_SYSTEM_NAME OR NOT CMAKE_SIZEOF_VOID_P EQUAL @IMKIT_SDK_POINTER_SIZE@)
    message(FATAL_ERROR "This ImKit SDK was built for ${IMKIT_SDK_SYSTEM_NAME}/${IMKIT_SDK_PROCESSOR}; use a matching artifact or build from source.")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL IMKIT_SDK_COMPILER_ID)
    message(FATAL_ERROR "This ImKit SDK was built with ${IMKIT_SDK_COMPILER_ID}; build from source for ${CMAKE_CXX_COMPILER_ID}.")
endif()
if(NOT IMKIT_SDK_ABI_CONFIRMED)
    message(FATAL_ERROR "Confirm Dear ImGui ${IMKIT_SDK_IMGUI_COMMIT}, matching imconfig types and runtime ABI by setting IMKIT_SDK_ABI_CONFIRMED=ON. Otherwise build from source.")
endif()
if(NOT TARGET imkit::host_imgui)
    add_library(imkit::host_imgui INTERFACE IMPORTED)
    set_property(TARGET imkit::host_imgui PROPERTY INTERFACE_LINK_LIBRARIES "${IMKIT_IMGUI_TARGET}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/imkitTargets.cmake")
check_required_components(imkit)
