@PACKAGE_INIT@
set(IMKIT_FONT_ASSET_DIR "${PACKAGE_PREFIX_DIR}/share/imkit/fonts")
include("${CMAKE_CURRENT_LIST_DIR}/imkitFontAssets.cmake")
if(NOT DEFINED IMKIT_IMGUI_TARGET OR NOT TARGET "${IMKIT_IMGUI_TARGET}")
    message(FATAL_ERROR "Create the host Dear ImGui target and set IMKIT_IMGUI_TARGET before find_package(imkit).")
endif()
if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
    message(FATAL_ERROR "This SDK requires Windows x64/MSVC. Build ImKit from source for other toolchains.")
endif()
if(MSVC_VERSION LESS 1950 OR MSVC_VERSION GREATER_EQUAL 1960)
    message(FATAL_ERROR "This SDK was built with MSVC v145 (19.5x). Rebuild ImKit from source for another toolset.")
endif()
if(NOT IMKIT_SDK_ABI_CONFIRMED)
    message(FATAL_ERROR "Confirm matching Dear ImGui 1.92.9b docking, default imconfig types, MSVC v145, x64, /MD[d] by setting IMKIT_SDK_ABI_CONFIRMED=ON. Otherwise build from source.")
endif()
if(NOT TARGET imkit::host_imgui)
    add_library(imkit::host_imgui INTERFACE IMPORTED)
    set_property(TARGET imkit::host_imgui PROPERTY INTERFACE_LINK_LIBRARIES "${IMKIT_IMGUI_TARGET}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/imkitTargets.cmake")
check_required_components(imkit)
