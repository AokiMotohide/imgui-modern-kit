---
import { LinkButton } from '@astrojs/starlight/components';

const base=import.meta.env.BASE_URL.replace(/\/$/, "");
const english=Astro.url.pathname.includes("/en/");
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="hero imkit-hero">
	<div class="imkit-hero-image imkit-film" id="film">
        <video controls playsinline preload="metadata"
            poster={`${base}/media/imkit-3.2-poster.jpg`}
            aria-label={english ? 'ImKit 3.2: Modern UI. Familiar workflow. English film with original music.' : 'ImKit 3.2の英語紹介動画。オリジナルBGM付き。'}>
            <source src={`${base}/media/imkit-3.2-film.mp4`} type="video/mp4" />
        </video>
        <p>{english ? 'Watch the 60-second film · English · Original music' : '60秒で見るImKit 3.2 · 英語 · オリジナルBGM'}</p>
    </div>
	<div class="imkit-hero-stack">
		<div class="imkit-hero-copy">
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{actions.length > 0 && (
			<div class="imkit-hero-actions">
				{actions.map(({ icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name}>{text}</LinkButton>
				))}
			</div>
		)}
	</div>
</div>
