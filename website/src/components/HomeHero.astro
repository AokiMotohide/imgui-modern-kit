---
import { LinkButton } from '@astrojs/starlight/components';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const base=import.meta.env.BASE_URL.replace(/\/$/, "");
const english=Astro.url.pathname.includes("/en/");
const language=english ? 'en' : 'ja';
const film=`imkit-4.0-film-${language}.mp4`;
const revision=createHash('sha256').update(readFileSync(resolve(`public/media/${film}`))).digest('hex').slice(0,12);
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="hero imkit-hero">
	<div class="imkit-hero-image imkit-film" id="film">
        <video controls playsinline preload="metadata"
            poster={`${base}/media/imkit-4.0-poster.jpg?v=${revision}`}
            aria-label={english ? 'ImKit 4.0: Modern UI. Familiar workflow. Three-minute film with music.' : 'ImKit 4.0の紹介動画（約3分）。BGM付き。'}>
            <source src={`${base}/media/${film}?v=${revision}`} type="video/mp4" />
        </video>
        <p>{english ? 'ImKit 4.0 film · About 3 minutes · Real operation, recorded in the Gallery' : 'ImKit 4.0の紹介動画 · 約3分 · Galleryを実際に操作して録画'}</p>
    </div>
	<div class="imkit-hero-stack">
		<div class="imkit-hero-copy">
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{actions.length > 0 && (
			<div class="imkit-hero-actions">
				{actions.map(({ icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name}>{text}</LinkButton>
				))}
			</div>
		)}
	</div>
</div>

<style>
    #film {
        scroll-margin-block-start: calc(var(--sl-nav-height, 4rem) + 1rem);
    }
</style>
